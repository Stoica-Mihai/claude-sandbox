UID=1000
GID=1000

# Dashboard web server port
DASHBOARD_PORT=8080

# Extra allowed WebSocket origins (comma-separated). Same-origin is always
# allowed; set this only when reaching the dashboard via a different origin
# (e.g. a reverse proxy): ALLOWED_WS_ORIGINS=https://claude.example.com
# ALLOWED_WS_ORIGINS=

# Absolute path to the project you want to mount in the container (default: ../)
WORKSPACE_PATH=

# Share tunnel (holesail sidecar) needs no configuration here: the frontend
# reaches it at http://holesail:9000 on the internal network, and the share
# key persists in the holesail-share-key volume. Toggle it from the dashboard
# globe — it always boots private.
