UID=1000
GID=1000

# Dashboard web server port (the only host-published port)
DASHBOARD_PORT=8080

# Internal ports — compose-network only, change only on a conflict:
# BACKEND_PORT=8081        # backend API
# TUNNEL_PORT=8090         # frontend's tunnel listener (holesail targets it)
# SHARE_CONTROL_PORT=9000  # holesail control API

# Extra allowed WebSocket origins (comma-separated). Same-origin is always
# allowed; set this only when reaching the dashboard via a different origin
# (e.g. a reverse proxy): ALLOWED_WS_ORIGINS=https://claude.example.com
# ALLOWED_WS_ORIGINS=

# Absolute path to the project you want to mount in the container (default: ../)
WORKSPACE_PATH=

# Share tunnel (holesail sidecar) needs no configuration here: the frontend
# reaches it at http://holesail:$SHARE_CONTROL_PORT on the internal network,
# and the share key persists in the holesail-share-key volume. Toggle it from
# the dashboard settings — it always boots private.
