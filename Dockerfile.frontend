# ── Builder stage: compile the Go frontend binary ──
FROM debian:bookworm-slim AS builder

# Supplied by the compose build arg (single-sourced in docker-compose.yml's
# x-go-version anchor).
ARG GO_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libc6-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

# Shared API-contract module (resolved via the go.mod replace => ../shared).
COPY shared/ /src/shared/

# Pre-download Go modules (cached unless go.mod/go.sum change)
COPY frontend/go.mod frontend/go.sum /src/frontend/
RUN cd /src/frontend && go mod download

# Copy source and build (busts cache on any file change)
COPY frontend/ /src/frontend/
RUN cd /src/frontend && go build -o /frontend-server .

# ── Runtime stage: minimal, no tmux/socat/claude ──
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Same UID/GID as the other producers so the shared logs volume is writable by
# the same user across containers.
ARG UID
ARG GID
RUN groupadd -g ${GID} claude && \
    useradd -m -u ${UID} -g claude claude

# Shared logs volume mountpoint, owned by claude so the volume inherits that
# ownership on first creation (this service writes /logs/frontend.log).
RUN mkdir -p /logs && chown claude:claude /logs

USER claude

COPY --from=builder /frontend-server /home/claude/frontend-server

CMD ["/home/claude/frontend-server"]
