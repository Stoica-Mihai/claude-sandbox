# ── Builder stage: compile the Go frontend binary ──
FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libc6-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://go.dev/dl/go1.26.1.linux-amd64.tar.gz | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

COPY frontend/ /src/frontend/
RUN cd /src/frontend && go build -o /frontend-server .

# ── Runtime stage: minimal, no tmux/socat/claude ──
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m frontend
USER frontend

COPY --from=builder /frontend-server /home/frontend/frontend-server

CMD ["/home/frontend/frontend-server"]
