# ── Builder stage: compile the Go backend binary ──
FROM debian:bookworm-slim AS builder

# Supplied by the compose build arg (single-sourced in docker-compose.yml's
# x-go-version anchor).
ARG GO_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libc6-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

# Local modules resolved via go.mod replace directives.
COPY shared/ /src/shared/
COPY sessiond/ /src/sessiond/

# Pre-download Go modules (cached unless go.mod/go.sum change)
COPY backend/go.mod backend/go.sum /src/backend/
RUN cd /src/backend && go mod download

# Copy source and build (busts cache on any source file change)
COPY backend/ /src/backend/
RUN cd /src/backend && go build -o /backend-server .

# ── Runtime stage: slim API bridge (no claude, no Go, no npm) ──
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Same UID/GID as the sessions container so the shared socket and upload
# volumes are writable by both.
ARG UID
ARG GID
RUN groupadd -g ${GID} claude && \
    useradd -m -u ${UID} -g claude claude
USER claude

# sessiond socket dir (shared named volume) and the persistent config dir
# (session index, settings editor files, transcripts).
ENV CLAUDE_SOCK_DIR=/home/claude/.local/state/claude/sock
ENV CLAUDE_CONFIG_DIR=/home/claude/.claude-sandbox
RUN mkdir -p /home/claude/.local/state/claude/sock

COPY --from=builder /backend-server /home/claude/backend-server

CMD ["/home/claude/backend-server"]
