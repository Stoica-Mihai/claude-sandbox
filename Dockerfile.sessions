# Go toolchain version — supplied by the compose build arg (single-sourced in
# docker-compose.yml's x-go-version anchor). Each stage re-declares `ARG
# GO_VERSION` to inherit it.
ARG GO_VERSION

# ── Builder stage: compile the sessiond binary ──
FROM debian:bookworm-slim AS builder

ARG GO_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libc6-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

# Shared API-contract module (resolved via sessiond's go.mod replace => ../shared).
COPY shared/ /src/shared/

# Pre-download Go modules (cached unless go.mod/go.sum change)
COPY sessiond/go.mod sessiond/go.sum /src/sessiond/
RUN cd /src/sessiond && go mod download

# Copy source and build (busts cache on any source file change)
COPY sessiond/ /src/sessiond/
RUN cd /src/sessiond && go build -o /sessiond .

# ── Runtime stage: the heavy session environment (claude + workspace tooling) ──
FROM debian:bookworm-slim

ARG GO_VERSION

# Runtime packages — everything Claude Code sessions need
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    git \
    openssh-client \
    xz-utils \
    curl \
    bubblewrap \
    qrencode \
    npm \
    ca-certificates \
    gcc \
    make \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Install RTK (static musl binary — no deps)
RUN curl -fsSL https://github.com/rtk-ai/rtk/releases/latest/download/rtk-x86_64-unknown-linux-musl.tar.gz \
    | tar -xz -C /usr/local/bin

# Go toolchain — needed for go test -race and dev workflow
RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

# UTF-8 locale for Unicode rendering
ENV LANG=C.UTF-8

# Create a non-root user with matching host UID
ARG UID
ARG GID
RUN groupadd -g ${GID} claude && \
    useradd -m -u ${UID} -g claude claude

# Shared logs volume mountpoint, owned by claude so the volume inherits that
# ownership on first creation (this service writes /logs/sessiond.log).
RUN mkdir -p /logs && chown claude:claude /logs

USER claude

# sessiond socket storage (shared with the backend via a named volume)
ENV CLAUDE_SOCK_DIR=/home/claude/.local/state/claude/sock
RUN mkdir -p /home/claude/.local/state/claude/sock

# Install Claude Code, pinned: the chat-sessions stream-json event vocabulary
# (sessiond's chat kind, the backend's conversation_reset/init re-key tap) is
# verified against this exact version. Bumping it is a deliberate, reviewed
# change — re-run the chat-sessions probes against the new version first.
ARG CLAUDE_CODE_VERSION=2.1.215
RUN curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_CODE_VERSION}"

# Install UV
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Install OpenSpec
RUN npm install -g --prefix /home/claude/.local @fission-ai/openspec@latest

ENV PATH="/home/claude/.local/bin:${PATH}"
ENV DO_NOT_TRACK=1
ENV FORCE_AUTOUPDATE_PLUGINS=true

# Pre-install Context7 MCP server
RUN npm install -g --prefix /home/claude/.local @upstash/context7-mcp

# Register marketplaces and install plugins
RUN claude plugin marketplace add anthropics/claude-plugins-official && \
    claude plugin marketplace add anthropics/skills && \
    claude plugin marketplace add HKUDS/CLI-Anything && \
    claude plugin marketplace add Stoica-Mihai/claude-skills && \
    claude plugin marketplace add JuliusBrussee/caveman && \
    claude plugin install superpowers@claude-plugins-official && \
    claude plugin install skill-creator@claude-plugins-official && \
    claude plugin install claude-api@anthropic-agent-skills && \
    claude plugin install document-skills@anthropic-agent-skills && \
    claude plugin install example-skills@anthropic-agent-skills && \
    claude plugin install cli-anything@cli-anything && \
    claude plugin install cli-anything-go@claude-skills && \
    claude plugin install opsx-ext@claude-skills && \
    claude plugin install caveman@caveman

# Headless GUI testing: a virtual X display (Xvfb) so native GUI apps can open
# windows, software OpenGL/EGL (Mesa llvmpipe) for GL apps, a tiny WM (fluxbox)
# for sane window mapping, and the tools Claude drives them with — xdotool
# (synthesize mouse/keyboard) + scrot (screenshot the display to a PNG Claude
# reads). No VNC/streaming: Claude drives its own testing, no human viewer.
# Root layer placed after the plugin installs so it doesn't bust their cache.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11-utils \
    xdotool \
    scrot \
    fluxbox \
    libgl1-mesa-dri \
    libegl-mesa0 \
    libgles2 \
    mesa-utils \
    && rm -rf /var/lib/apt/lists/*
USER claude

# Every session gets the virtual display; software GL forces llvmpipe (no GPU).
ENV DISPLAY=:99
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV XDG_RUNTIME_DIR=/tmp/xdg-runtime

# ── Nix (single-user, non-root): per-project dependencies without image bloat ──
# Every project ships a flake.nix; a session runs `nix develop` and gets its
# exact toolchain + system libs. This replaces hand-rolled prefixes (extracting
# .debs into /tmp and wiring PKG_CONFIG_PATH/LD_LIBRARY_PATH by hand), which
# broke and vanished whenever the container was recreated.
#
# /nix is a named volume in compose: Docker seeds it from this image layer on
# first creation, then it persists across rebuilds, so installs stick. (A nix
# version bump here therefore does NOT reach an existing volume — recreate the
# volume to upgrade.)
USER root
RUN mkdir -m 0755 /nix && chown claude:claude /nix
USER claude
RUN curl -fsSL https://nixos.org/nix/install -o /tmp/nix-install.sh && \
    sh /tmp/nix-install.sh --no-daemon --no-channel-add && \
    rm -f /tmp/nix-install.sh
# Flakes only — no channels.
RUN mkdir -p /home/claude/.config/nix && \
    printf 'experimental-features = nix-command flakes\n' > /home/claude/.config/nix/nix.conf
# nix keeps its profile + GC roots in $XDG_STATE_HOME/nix (~/.local/state/nix),
# which is container-local and wiped on every rebuild — `nix profile install`
# would lose its GC root and be collected. Relocate that one state dir INTO
# /nix (the persisted volume) and symlink it back, so profiles/GC roots persist
# while nix keeps its normal layout.
RUN mv /home/claude/.local/state/nix /nix/var/claude-nix-state && \
    ln -sfn /nix/var/claude-nix-state /home/claude/.local/state/nix
ENV PATH="/nix/var/claude-nix-state/profiles/profile/bin:${PATH}"

# Shell function: direct CLI `claude` is disabled — sessions are created and
# managed from the dashboard, which asks sessiond to spawn the real binary.
RUN cat >> /home/claude/.bashrc <<'BASHEOF'
claude() {
  cat >&2 <<'MSG'
Direct `claude` sessions are disabled in this container.
Create and open sessions from the dashboard:
  http://localhost:8080  (or the host's DASHBOARD_PORT)
MSG
  return 1
}
BASHEOF

# Scoped, host-isolated Claude config dir (mounted from the host, persists auth
# and sessions for this sandbox without touching the host's real ~/.claude).
ENV CLAUDE_CONFIG_DIR=/home/claude/.claude-sandbox

# Copy the pre-built sessiond binary + entrypoint (seeds the scoped config dir)
COPY --from=builder /sessiond /home/claude/sessiond
COPY --chown=claude:claude entrypoint.sh /home/claude/entrypoint.sh
RUN chmod +x /home/claude/entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/home/claude/entrypoint.sh"]
CMD ["/home/claude/sessiond"]
