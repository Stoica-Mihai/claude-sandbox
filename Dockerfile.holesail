# ── Builder stage: install pinned holesail deps (sodium-native prebuilds) ──
FROM node:22-bookworm-slim AS builder

WORKDIR /app
COPY holesail/package.json holesail/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# ── Runtime stage ──
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY holesail/package.json holesail/server.js holesail/logsink.js ./

# Run as the host UID/GID (matching the Go producers) so holesail can write the
# shared, claude-owned logs volume. The /data (key) and /logs mountpoints are
# chowned before first mount so the named volumes inherit that ownership.
ARG UID
ARG GID
RUN mkdir -p /data /logs && chown ${UID}:${GID} /data /logs
USER ${UID}:${GID}

CMD ["node", "/app/server.js"]
